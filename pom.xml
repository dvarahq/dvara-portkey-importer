<!--
  A standalone project: no parent and no runtime dependency. It reads JSON with a small reader of its
  own. The open gateway is a test dependency, used to prove the files it writes load in the gateway's
  own loader.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dvarahq.tools</groupId>
    <artifactId>dvara-portkey-importer</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>DVARA Portkey importer</name>
    <description>Reads a Portkey gateway config (JSON) and writes an equivalent DVARA gateway.yaml, with a report of
        what carried over and what did not.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The open gateway the tests load the output with. The latest release by default, so the
             project builds from Maven Central alone; -Pdvara-snapshot -Ddvara.version=<x>-SNAPSHOT
             checks it against a newer build. -->
        <dvara.version>1.13.0</dvara.version>
        <junit.version>5.12.2</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <main.class>com.dvarahq.tools.portkey.Main</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.dvarahq</groupId>
            <artifactId>dvara-gateway-autoconfigure</artifactId>
            <version>${dvara.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.dvarahq</groupId>
            <artifactId>dvara-gateway-policy</artifactId>
            <version>${dvara.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- One runnable jar: java -jar dvara-portkey-importer.jar config.json -o out/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>dvara-portkey-importer</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Resolves the open gateway's snapshots, for -Ddvara.version=<x>-SNAPSHOT. -->
        <profile>
            <id>dvara-snapshot</id>
            <repositories>
                <repository>
                    <id>dvara-oss</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots/</url>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
</project>
